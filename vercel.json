      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/startups",
      "destination": "/partnered-startups",
      "permanent": true
    },
    {
      "source": "/partnered",
