    },
    {
      "source": "/ur-services",
      "destination": "/our-services",
      "permanent": true
    },
    {
      "source": "/ur-services/:match*",
      "destination": "/our-services/:match*",
      "permanent": true
    },
    {
      "source": "/ur-products",
      "destination": "/our-products",
      "permanent": true
    },
    {
      "source": "/ur-highlights",
      "destination": "/our-highlights",
      "permanent": true
    },
    {
      "source": "/ur-highlights/:match*",
      "destination": "/our-highlights/:match*",
      "permanent": true
    },
    {
      "source": "/ratings",
      "destination": "/rate-us",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/posts",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/meet-the-founders-how-karthick-krishna-m-s-and",
      "destination": "/blog/meet-the-leadership-how-founder-karthick-krishna-m-s",
      "permanent": true
    },
    {
      "source": "/blog/meet-the-founders-how-karthick-krishna-m-s-and.html",
      "destination": "/blog/meet-the-leadership-how-founder-karthick-krishna-m-s",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rate",
      "destination": "/rate/index.html"
    },
    {
      "source": "/rate/",
      "destination": "/rate/index.html"
    },
    {
      "source": "/rate/review/:id",
      "destination": "/rate/index.html"
    },
    {
      "source": "/rate-us/review/:id",
      "destination": "/rate/index.html"
    },
    {
      "source": "/review/:id",
      "destination": "/rate/index.html"
    },
    {
      "source": "/rate/category/:category",
      "destination": "/rate/index.html"
    },
    {
      "source": "/rate/sitemap(.*)\\.xml",
      "destination": "/rate/sitemap$1.xml"
    },
    {
      "source": "/rate/robots.txt",
      "destination": "/rate/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}